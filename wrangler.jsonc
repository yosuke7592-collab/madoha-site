{
  "name": "icy-leaf-b200",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-13",
  "vars": {
    "ENVIRONMENT": "production",
    "STRIPE_MODE": "live",
    "PUBLIC_SITE_URL": "https://madoha.jp",
    "MADOHA_ENABLE_SALES_FLOW": "false",
    "MADOHA_ENABLE_LIVE_MEASUREMENT": "false",
    "MADOHA_MEASUREMENT_MODE": "mock",
    "MADOHA_PAID_DIAGNOSIS_MAX_COST_USD": "0.70"
  },
  "ratelimits": [
    { "name": "DIAGNOSIS_ENTRY_LIMITER", "namespace_id": "2003", "simple": { "limit": 30, "period": 60 } },
    { "name": "DIAGNOSIS_CHECKOUT_LIMITER", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sample-kyoudo.html", "/sample-kyoudo-data.js", "/data/samples/kyoudo-housing-paid-diagnosis.json"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madoha-paid-diagnosis-production",
      "database_id": "76c464ef-62fd-431b-b258-00680bbe0a5c",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "DIAGNOSIS_QUEUE", "queue": "madoha-diagnosis-production" }
    ],
    "consumers": [
      { "queue": "madoha-diagnosis-production", "max_batch_size": 1, "max_batch_timeout": 1 }
    ]
  },
  "observability": { "enabled": true }
}
