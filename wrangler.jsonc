{
  "name": "icy-leaf-b200",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-13",
  "vars": {
    "MADOHA_ENABLE_SALES_FLOW": "false",
    "MADOHA_ENABLE_LIVE_MEASUREMENT": "false",
    "MADOHA_MEASUREMENT_MODE": "mock",
    "MADOHA_PAID_DIAGNOSIS_MAX_COST_USD": "0.70"
  },
  "ratelimits": [
    { "name": "DIAGNOSIS_CHECKOUT_LIMITER", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sample-kyoudo.html", "/sample-kyoudo-data.js", "/data/samples/kyoudo-housing-paid-diagnosis.json"],
    "not_found_handling": "single-page-application"
  }
}
