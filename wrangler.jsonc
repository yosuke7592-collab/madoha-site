{
  "name": "icy-leaf-b200",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-13",
  "vars": {
    "MADOHA_ENABLE_SALES_FLOW": "false",
    "MADOHA_ENABLE_LIVE_MEASUREMENT": "false",
    "MADOHA_MEASUREMENT_MODE": "mock",
    "MADOHA_PAID_DIAGNOSIS_MAX_COST_USD": "0.70",
    "FREE_DIAGNOSIS_COST_CAP_USD": "0.21",
    "FREE_DIAGNOSIS_DAILY_COST_CAP_USD": "5.00",
    "FREE_DIAGNOSIS_IP_HOURLY_LIMIT": "12",
    "FREE_DIAGNOSIS_IP_DAILY_LIMIT": "40",
    "FREE_DIAGNOSIS_REUSE_SECONDS": "86400"
  },
  "ratelimits": [
    { "name": "FREE_START_LIMITER", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sample-kyoudo.html", "/sample-kyoudo-data.js", "/data/samples/kyoudo-housing-paid-diagnosis.json"],
    "not_found_handling": "single-page-application"
  }
}
