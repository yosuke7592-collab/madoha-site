{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "madoha-paid-diagnosis-staging",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sample-kyoudo.html", "/sample-kyoudo-data.js", "/data/samples/kyoudo-housing-paid-diagnosis.json"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "MADOHA_MEASUREMENT_MODE": "mock",
    "MADOHA_ENABLE_LIVE_MEASUREMENT": "false",
    "MADOHA_ENABLE_SALES_FLOW": "true",
    "PUBLIC_SITE_URL": "https://madoha-paid-diagnosis-staging.yosuke7592.workers.dev",
    "MADOHA_PAID_DIAGNOSIS_MAX_COST_USD": "0.20",
    "FREE_DIAGNOSIS_COST_CAP_USD": "0.21",
    "FREE_DIAGNOSIS_DAILY_COST_CAP_USD": "5.00",
    "FREE_DIAGNOSIS_IP_HOURLY_LIMIT": "12",
    "FREE_DIAGNOSIS_IP_DAILY_LIMIT": "40",
    "FREE_DIAGNOSIS_REUSE_SECONDS": "86400",
    "DATAFORSEO_RETRIEVAL_MODE": "live"
  },
  "ratelimits": [
    { "name": "FREE_START_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madoha-paid-diagnosis-staging",
      "database_id": "286da060-a211-4d30-8e62-15c3a5a3ba32",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "DIAGNOSIS_QUEUE", "queue": "madoha-diagnosis-staging" }
    ],
    "consumers": [
      { "queue": "madoha-diagnosis-staging", "max_batch_size": 1, "max_batch_timeout": 1 }
    ]
  },
  "observability": { "enabled": true }
}
