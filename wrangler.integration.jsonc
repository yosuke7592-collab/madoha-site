{
  "name": "madoha-paid-diagnosis-integration-local",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-05-03",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ENVIRONMENT": "integration",
    "MADOHA_MEASUREMENT_MODE": "mock",
    "MADOHA_ENABLE_LIVE_MEASUREMENT": "false",
    "MADOHA_PAID_DIAGNOSIS_MAX_COST_USD": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madoha-integration-local",
      "database_id": "11111111-1111-1111-1111-111111111111",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "DIAGNOSIS_QUEUE", "queue": "madoha-diagnosis-integration-local" }
    ],
    "consumers": [
      { "queue": "madoha-diagnosis-integration-local", "max_batch_size": 1, "max_batch_timeout": 1 }
    ]
  }
}
